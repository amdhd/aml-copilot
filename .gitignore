data/
runs/
.venv/
node_modules/
ui/dist/

# pg_dump output. Not regenerable for free: the cases table holds narratives
# and evidence bundles that cost provider calls to produce.
backups/
__pycache__/
*.pyc
.env

# artifacts/ is a build-output directory -- models, batch scores and run logs,
# all regenerated by make. Ignored by default, with three deliberate exceptions:
#
#   eval_results.json         the measurement the README table quotes
#   model-HI-Small_Trans.pt   122KB but 2h42m to retrain, and section 9's S3
#                             bucket does not exist until week 7. Delete this
#                             exception once the model lives there.
#
# The XGBoost baseline is not kept: it regenerates in 46 seconds.
artifacts/*
!artifacts/eval_results.json
!artifacts/model-HI-Small_Trans.pt
