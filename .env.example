# Copy to .env and fill in. .env is gitignored - never commit it.
# Provider is a base_url + model, so Groq / Gemini / DeepSeek / local vLLM
# are all a config change with no code change.

AML_LLM_BASE_URL=https://api.groq.com/openai/v1
AML_LLM_MODEL=
AML_LLM_API_KEY=

# AML_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AML_LLM_MODEL=gemini-flash-latest

AML_DSN=postgresql://aml:aml@localhost:5432/aml
AML_REDIS=redis://localhost:6379
AML_MAX_JOBS=1

# Anything but "local" turns the development defaults above into errors raised
# at import, so a task definition missing a variable fails on the way up rather
# than one case at a time. The task definition sets AML_ENV=aws.
AML_ENV=local
